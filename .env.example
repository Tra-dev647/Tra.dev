# PostgreSQL connection string
# Use any Postgres provider: Supabase, Neon, Railway, or local
DATABASE_URL=

# JWT secret for admin auth (generate: openssl rand -base64 32)
JWT_SECRET=

# Admin bootstrap (used on first db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Bakong KHQR payments (https://api-bakong.nbc.gov.kh/register for the token)
BAKONG_ACCOUNT_ID=          # your Bakong account, e.g. yourname@abaa
BAKONG_API_TOKEN=           # token from Bakong Open API (used to verify payments)
BAKONG_MERCHANT_NAME=TRATOPUP
BAKONG_MERCHANT_CITY=Phnom Penh
# Optional, merchant accounts only (both required together):
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
# Optional:
# BAKONG_QR_EXPIRE_MINUTES=10
# BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1

# Base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=

# Public URL of the site (https)
PUBLIC_APP_URL=

# Simulation mode: when "true", payments auto-complete after 3s (for dev/demo)
PAYMENT_SIMULATION_MODE=
